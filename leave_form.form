{
  "components": [
    {
      "text": "# Leave Request",
      "type": "text",
      "id": "Field_header"
    },
    {
      "label": "Name",
      "type": "textfield",
      "id": "Field_name",
      "key": "name",
      "validate": { "required": true }
    },
    {
      "subtype": "date",
      "dateLabel": "Date",
      "type": "datetime",
      "id": "Field_date",
      "key": "leaveDate",
      "validate": { "required": true }
    },
    {
      "label": "Number of days",
      "type": "number",
      "id": "Field_days",
      "key": "days"
    },
    {
      "label": "Reason",
      "type": "textarea",
      "id": "Field_reason",
      "key": "reason",
      "validate": { "required": true }
    }
  ],
  "type": "default",
  "id": "leave_form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.5.0",
  "schemaVersion": 16
}